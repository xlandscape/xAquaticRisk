<?xml version='1.0' encoding='utf-8'?>
<ns0:Parameters xmlns:ns0="urn:xAquaticRisk" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="urn:xAquaticRisk model/variant/parameters.xsd">
  <ns0:Control>
    
    <ns0:ExperimentID>muenster_test_2</ns0:ExperimentID>

    
    <ns0:ParentRun />

    
    <ns0:NumberMC>3</ns0:NumberMC>

    
    <ns0:NumberParallelProcesses>3</ns0:NumberParallelProcesses>

    
    <ns0:CascadeToxswaWorkers>12</ns0:CascadeToxswaWorkers>

    
    <ns0:DeleteComponentProcessingFolders>true</ns0:DeleteComponentProcessingFolders>

    
    <ns0:VerboseLogging>false</ns0:VerboseLogging>

    
    <ns0:EnableProfiling>false</ns0:EnableProfiling>

    
    <ns0:ProfilingWaitingTime>5</ns0:ProfilingWaitingTime>
  </ns0:Control>
  <ns0:Scenario>
    
    <ns0:LandscapeScenario>scenario/muenster-T-Di-02.5-20220429-postproceccing-toxwa</ns0:LandscapeScenario>

    
    <ns0:SimulationStart>1991-01-01</ns0:SimulationStart>

    
    <ns0:SimulationEnd>2015-05-07</ns0:SimulationEnd>
  </ns0:Scenario>
  <ns0:PppUse>
    
    <ns0:ApplicationRate>12.5</ns0:ApplicationRate>

    
    <ns0:ApplicationTimeWindow>04-02 to 05-02</ns0:ApplicationTimeWindow>
  </ns0:PppUse>
  <ns0:Mitigation>
    
    <ns0:InCropBuffer>0</ns0:InCropBuffer>

    
    <ns0:TechnologyDriftReduction>0</ns0:TechnologyDriftReduction>
  </ns0:Mitigation>
  <ns0:Exposure>
    
    <ns0:RautmannClass>arable</ns0:RautmannClass>

    
    <ns0:DepositionInputFile />
  </ns0:Exposure>
  <ns0:EnvironmentalFate>
    
    <ns0:RunStepsRiverNetwork>false</ns0:RunStepsRiverNetwork>

    
    <ns0:RunCascadeToxswa>true</ns0:RunCascadeToxswa>

    
    <ns0:ThresholdSW>0.001</ns0:ThresholdSW>

    
    <ns0:ThresholdSediment>0.1</ns0:ThresholdSediment>

    
    <ns0:MolarMass>505.2</ns0:MolarMass>

    
    <ns0:SaturatedVapourPressure>1.10E-06</ns0:SaturatedVapourPressure>

    
    <ns0:MolarEnthalpyOfVaporization>95</ns0:MolarEnthalpyOfVaporization>

    
    <ns0:SolubilityInWater>0.001</ns0:SolubilityInWater>

    
    <ns0:MolarEnthalpyOfDissolution>27</ns0:MolarEnthalpyOfDissolution>

    
    <ns0:DiffusionCoefficient>4.30E-05</ns0:DiffusionCoefficient>

    
    <ns0:DT50sw>1000</ns0:DT50sw>

    
    <ns0:MolarActivationEnthalpyOfTransformationInWater>65.4</ns0:MolarActivationEnthalpyOfTransformationInWater>

    
    <ns0:DT50sed>43.9</ns0:DT50sed>

    
    <ns0:MolarActivationEnthalpyOfTransformationInSediment>65.4</ns0:MolarActivationEnthalpyOfTransformationInSediment>

    
    <ns0:KOC>460000</ns0:KOC>

    
    <ns0:ReferenceConcentrationForKOC>1</ns0:ReferenceConcentrationForKOC>

    
    <ns0:FreundlichExponentInSedimentAndSuspendedParticles>0.93</ns0:FreundlichExponentInSedimentAndSuspendedParticles>

    
    <ns0:CoefficientForLinearAdsorptionOnMacrophytes>0</ns0:CoefficientForLinearAdsorptionOnMacrophytes>
  </ns0:EnvironmentalFate>
  <ns0:Effects>
    
    <ns0:RunLGuts>true</ns0:RunLGuts>

    
    <ns0:NumberOfWarmUpYears>1</ns0:NumberOfWarmUpYears>

  
    <ns0:RecoveryPeriodYears>1</ns0:RecoveryPeriodYears>

    
    <ns0:Species1>Asellus aquaticus</ns0:Species1>

    
    <ns0:Species1DominantRateConstantSD>0.01188</ns0:Species1DominantRateConstantSD>

    
    <ns0:Species1ThresholdConcentrationSD>0.05507</ns0:Species1ThresholdConcentrationSD>

    
    <ns0:Species1KillingRateSD>0.002615</ns0:Species1KillingRateSD>

      
    <ns0:Species1DominantRateConstantIT>0.0005541</ns0:Species1DominantRateConstantIT>

    
    <ns0:Species1ThresholdDistributionIT>0.4429</ns0:Species1ThresholdDistributionIT>

    
    <ns0:Species1WidthOfThresholdDistributionIT>1.582</ns0:Species1WidthOfThresholdDistributionIT>

    
    <ns0:Species2>Cloeon dipterum</ns0:Species2>

    
    <ns0:Species2DominantRateConstantSD>0.03719</ns0:Species2DominantRateConstantSD>

    
    <ns0:Species2ThresholdConcentrationSD>4.702</ns0:Species2ThresholdConcentrationSD>

    
    <ns0:Species2KillingRateSD>0.0009361</ns0:Species2KillingRateSD>

      
    <ns0:Species2DominantRateConstantIT>0.01416</ns0:Species2DominantRateConstantIT>

    
    <ns0:Species2ThresholdDistributionIT>36.27</ns0:Species2ThresholdDistributionIT>

    
    <ns0:Species2WidthOfThresholdDistributionIT>1.648</ns0:Species2WidthOfThresholdDistributionIT>

    
    <ns0:Species3>Gammarus pulex</ns0:Species3>

    
    <ns0:Species3DominantRateConstantSD>0.008858</ns0:Species3DominantRateConstantSD>

    
    <ns0:Species3ThresholdConcentrationSD>0.6292</ns0:Species3ThresholdConcentrationSD>

    
    <ns0:Species3KillingRateSD>0.01989</ns0:Species3KillingRateSD>

      
    <ns0:Species3DominantRateConstantIT>0.002324</ns0:Species3DominantRateConstantIT>

    
    <ns0:Species3ThresholdDistributionIT>0.8206</ns0:Species3ThresholdDistributionIT>

    
    <ns0:Species3WidthOfThresholdDistributionIT>3.049</ns0:Species3WidthOfThresholdDistributionIT>
  </ns0:Effects>
  <ns0:Settings>
    
    <ns0:ExportToSqlite>true</ns0:ExportToSqlite>
  </ns0:Settings>
  <ns0:Analysis>
      
      <ns0:ReportingReaches>r577</ns0:ReportingReaches>

      
      <ns0:PecDisplayedTime>2015-05-02 12:00</ns0:PecDisplayedTime>
  </ns0:Analysis>
</ns0:Parameters>