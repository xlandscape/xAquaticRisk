<Configuration>
  <MappedFolders>
    <MappedFolder>
      <HostFolder>C:\LocalWork\xAquaticRisk</HostFolder>
      <SandboxFolder>C:\xAquaticRisk</SandboxFolder>
      <ReadOnly>false</ReadOnly>
    </MappedFolder>
  </MappedFolders>
  <LogonCommand>
    <Command>cmd.exe /c "cd /d C:\xAquaticRisk && __start__.bat"</Command>
  </LogonCommand>
</Configuration>
